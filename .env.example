# A port amin a konténer belül fut az app (ezen a porton kell a kulso reverse proxy-nak elernie)
PORT=3000

# Session aláíráshoz használt titkos kulcs - generálj egy hosszú random stringet éles használat előtt
# pl.: openssl rand -base64 48
SESSION_SECRET=change_this_to_a_long_random_secret

# A seed superadmin email címe (első indításkor jön létre, ha még nincs egyetlen user sem)
SEED_ADMIN_EMAIL=admin@example.com

NODE_ENV=production
